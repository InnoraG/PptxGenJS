{
	"name": "pptxgenjs",
	"version": "4.0.1",
	"author": "Brent Ely (https://github.com/gitbrent/)",
	"description": "Create JavaScript PowerPoint Presentations",
	"homepage": "https://gitbrent.github.io/PptxGenJS/",
	"license": "MIT",
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"import": "./dist/pptxgen.es.js",
			"require": "./dist/pptxgen.cjs.js"
		},
		"./decypher": {
			"types": "./types/pptx-decypher/index.d.ts",
			"import": "./dist/node/pptx-decypher/index.js"
		},
		"./betterpptx-mcp": "./betterpptx-mcp/server.mjs",
		"./betterpptx-mcp/engine": "./betterpptx-mcp/engine.mjs",
		"./betterpptx-mcp/tools": "./betterpptx-mcp/tools.mjs",
		"./betterpptx-mcp/http": "./betterpptx-mcp/server-http.mjs",
		"./capabilities.json": "./docs/capabilities/betterpptx-mcp-capabilities.json",
		"./package.json": "./package.json"
	},
	"main": "dist/pptxgen.cjs.js",
	"module": "dist/pptxgen.es.js",
	"bin": {
		"betterpptx-mcp": "betterpptx-mcp/cli.mjs",
		"betterpptx-mcp-http": "betterpptx-mcp/http-cli.mjs"
	},
	"files": [
		"dist",
		"types",
		"betterpptx-mcp",
		"docs/capabilities",
		"demos/common/images/sample_logo.png",
		"demos/common/media/sample.mp3",
		"demos/common/media/sample.mp4",
		"demos/common/media/sample-hd.m4v",
		"demos/common/media/sample.wav",
		"demos/betterpptx-mcp-premium-assets/models/*.glb",
		"demos/betterpptx-mcp-premium-assets/posters/*.png",
		"demos/betterpptx-mcp-premium-assets/textures/*.jpg",
		"demos/betterpptx-mcp-reference-assets/3d-gradient-style-agency/models/*.glb",
		"demos/betterpptx-mcp-reference-assets/3d-gradient-style-agency/images/*",
		"demos/betterpptx-mcp-reference-assets/3d-gradient-style-agency/previews/*.png",
		"demos/betterpptx-mcp-reference-assets/3d-gradient-style-agency/shape-scenes/*.json",
		"demos/betterpptx-mcp-reference-assets/3d-gradient-style-agency/manifest.json",
		"demos/betterpptx-mcp-online-assets/README.md",
		"demos/betterpptx-mcp-online-assets/manifest.json",
		"demos/betterpptx-mcp-online-assets/icons/lucide/*.svg",
		"demos/betterpptx-mcp-online-assets/icons/lucide/LICENSE",
		"demos/betterpptx-mcp-online-assets/icons/lucide/package.json",
		"demos/betterpptx-mcp-online-assets/icons/lucide/source-metadata.json",
		"demos/betterpptx-mcp-online-assets/maps/natural-earth/*.geojson",
		"demos/betterpptx-mcp-online-assets/models/khronos/*.glb",
		"demos/betterpptx-mcp-online-assets/models/khronos/metadata/*.json",
		"demos/betterpptx-mcp-online-assets/models/khronos/previews/*",
		"demos/betterpptx-mcp-online-assets/models/open-source-3d/**/*",
		"demos/betterpptx-mcp-online-assets/models/open-source-3d-quality/**/*",
		"demos/betterpptx-mcp-online-assets/remote-indexes/*.json",
		"demos/betterpptx-mcp-online-assets/textures/polyhaven/*.png",
		"demos/betterpptx-mcp-data/natural-earth/*.geojson",
		"demos/ultimate-showcase/assets/lab-pyramid.glb",
		"demos/ultimate-showcase/assets/model-fallback.png",
		"tools/betterpptx-mcp-reference-recreation-harness.mjs",
		"tools/betterpptx-mcp-build-3d-powerpoint-catalog.mjs",
		"tools/betterpptx-mcp-build-3d-presentation-derivatives.mjs",
		"tools/betterpptx-mcp-fetch-open-source-3d-assets.mjs",
		"tools/betterpptx-mcp-fetch-online-assets.mjs",
		"tools/betterpptx-mcp-fetch-iconscout-assets.mjs",
		"tools/betterpptx-mcp-build-iconscout-index.mjs",
		"tools/betterpptx-mcp-frozen-reference-regression.mjs",
		"PPTX_ULTIMATE_DECYPHER_TOOL.mjs",
		"ULTIMATE_PPTX_XPATH_COMPARATOR_v2h_DECYPHER.ps1"
	],
	"types": "types",
	"scripts": {
		"build": "node tools/embed-ui-truth-templates.mjs && rollup -c --bundleConfigAsCjs",
		"start": "gulp",
		"ship": "gulp ship",
		"defs": "gulp reactTestDefs",
		"watch": "rollup -cw",
		"assets:online": "node tools/betterpptx-mcp-fetch-online-assets.mjs",
		"assets:open3d": "node tools/betterpptx-mcp-fetch-open-source-3d-assets.mjs",
		"assets:open3d:quality": "node tools/betterpptx-mcp-build-3d-presentation-derivatives.mjs",
		"assets:open3d:catalog": "node tools/betterpptx-mcp-build-3d-powerpoint-catalog.mjs",
		"assets:iconscout": "node tools/betterpptx-mcp-fetch-iconscout-assets.mjs",
		"assets:iconscout:index": "node tools/betterpptx-mcp-build-iconscout-index.mjs",
		"test:mcp-reference": "node tools/betterpptx-mcp-reference-recreation-harness.mjs",
		"test:mcp-reference-legacy": "node tools/betterpptx-mcp-frozen-reference-regression.mjs"
	},
	"browser": {
		"express": false,
		"fs": false,
		"https": false,
		"image-size": false,
		"node:fs": false,
		"node:https": false,
		"os": false,
		"path": false
	},
	"dependencies": {
		"@gltf-transform/core": "^4.3.0",
		"@gltf-transform/extensions": "^4.3.0",
		"@gltf-transform/functions": "^4.3.0",
		"@google-cloud/firestore": "^7.11.6",
		"@google-cloud/storage": "^7.16.0",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"@types/node": "^22.8.1",
		"@xmldom/xmldom": "^0.8.11",
		"express": "^5.1.0",
		"google-gax": "^4.6.1",
		"https": "^1.0.0",
		"image-size": "^1.2.1",
		"jszip": "^3.10.1",
		"three": "^0.184.0",
		"xml2js": "^0.6.2"
	},
	"devDependencies": {
		"@eslint/js": "^9.25.1",
		"@rollup/plugin-commonjs": "^28.0.1",
		"@rollup/plugin-node-resolve": "^16.0.1",
		"@stylistic/eslint-plugin": "^4.2.0",
		"@typescript-eslint/eslint-plugin": "^8.31.0",
		"@typescript-eslint/parser": "^8.31.0",
		"eslint": "^9.25.1",
		"fbx2gltf": "0.9.7-p1",
		"gulp": "^5.0.0",
		"gulp-concat": "^2.6.1",
		"gulp-delete-lines": "0.0.7",
		"gulp-ignore": "^3.0.0",
		"gulp-insert": "^0.5.0",
		"gulp-sourcemaps": "^3.0.0",
		"gulp-uglify": "^3.0.2",
		"rollup": "^4.24.2",
		"rollup-plugin-typescript2": "^0.36.0",
		"tslib": "^2.8.0",
		"typescript": "^5.6.3",
		"typescript-eslint": "^8.31.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/gitbrent/PptxGenJS.git"
	},
	"keywords": [
		"es6-powerpoint",
		"html-to-powerpoint",
		"javascript-create-powerpoint",
		"javascript-create-pptx",
		"javascript-generate-pptx",
		"javascript-powerpoint",
		"javascript-powerpoint-charts",
		"javascript-pptx",
		"js-create-powerpoint",
		"js-create-pptx",
		"js-generate-powerpoint",
		"js-powerpoint",
		"js-powerpoint-library",
		"js-powerpoint-pptx",
		"node-powerpoint",
		"officejs-alternative",
		"react-powerpoint",
		"slide-generator",
		"typescript-powerpoint"
	],
	"bugs": {
		"url": "https://github.com/gitbrent/PptxGenJS/issues"
	},
	"directories": {
		"doc": "docs"
	},
	"type": "commonjs"
}
