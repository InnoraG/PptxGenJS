{
	"name": "pptxgenjs",
	"version": "4.0.1",
	"author": "Brent Ely (https://github.com/gitbrent/)",
	"description": "Create JavaScript PowerPoint Presentations",
	"homepage": "https://gitbrent.github.io/PptxGenJS/",
	"license": "MIT",
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"import": "./dist/pptxgen.es.js",
			"require": "./dist/pptxgen.cjs.js"
		},
		"./decypher": {
			"types": "./types/pptx-decypher/index.d.ts",
			"import": "./dist/node/pptx-decypher/index.js"
		},
		"./betterpptx-mcp": "./betterpptx-mcp/server.mjs",
		"./betterpptx-mcp/tools": "./betterpptx-mcp/tools.mjs",
		"./betterpptx-mcp/http": "./betterpptx-mcp/server-http.mjs",
		"./capabilities.json": "./docs/capabilities/betterpptx-mcp-capabilities.json",
		"./package.json": "./package.json"
	},
	"main": "dist/pptxgen.cjs.js",
	"module": "dist/pptxgen.es.js",
	"bin": {
		"betterpptx-mcp": "betterpptx-mcp/cli.mjs",
		"betterpptx-mcp-http": "betterpptx-mcp/http-cli.mjs"
	},
	"files": [
		"dist",
		"types",
		"betterpptx-mcp",
		"docs/capabilities",
		"demos/common/images/sample_logo.png",
		"demos/common/media/sample.mp3",
		"demos/common/media/sample.mp4",
		"demos/common/media/sample-hd.m4v",
		"demos/common/media/sample.wav",
		"demos/betterpptx-mcp-premium-assets/models/*.glb",
		"demos/betterpptx-mcp-premium-assets/posters/*.png",
		"demos/betterpptx-mcp-premium-assets/textures/*.jpg",
		"demos/betterpptx-mcp-reference-assets/3d-gradient-style-agency/models/*.glb",
		"demos/betterpptx-mcp-reference-assets/3d-gradient-style-agency/images/*",
		"demos/betterpptx-mcp-reference-assets/3d-gradient-style-agency/previews/*.png",
		"demos/betterpptx-mcp-reference-assets/3d-gradient-style-agency/shape-scenes/*.json",
		"demos/betterpptx-mcp-reference-assets/3d-gradient-style-agency/manifest.json",
		"demos/betterpptx-mcp-online-assets/README.md",
		"demos/betterpptx-mcp-online-assets/manifest.json",
		"demos/betterpptx-mcp-online-assets/icons/lucide/*.svg",
		"demos/betterpptx-mcp-online-assets/icons/lucide/LICENSE",
		"demos/betterpptx-mcp-online-assets/icons/lucide/package.json",
		"demos/betterpptx-mcp-online-assets/icons/lucide/source-metadata.json",
		"demos/betterpptx-mcp-online-assets/maps/natural-earth/*.geojson",
		"demos/betterpptx-mcp-online-assets/models/khronos/*.glb",
		"demos/betterpptx-mcp-online-assets/models/khronos/metadata/*.json",
		"demos/betterpptx-mcp-online-assets/models/khronos/previews/*",
		"demos/betterpptx-mcp-online-assets/models/open-source-3d/**/*",
		"demos/betterpptx-mcp-online-assets/models/open-source-3d-quality/**/*",
		"demos/betterpptx-mcp-online-assets/remote-indexes/*.json",
		"demos/betterpptx-mcp-online-assets/textures/polyhaven/*.png",
		"demos/betterpptx-mcp-data/natural-earth/*.geojson",
		"demos/ultimate-showcase/assets/lab-pyramid.glb",
		"demos/ultimate-showcase/assets/model-fallback.png",
		"tools/betterpptx-mcp-reference-recreation-harness.mjs",
		"tools/betterpptx-mcp-build-3d-powerpoint-catalog.mjs",
		"tools/betterpptx-mcp-build-3d-presentation-derivatives.mjs",
		"tools/betterpptx-mcp-fetch-open-source-3d-assets.mjs",
		"tools/betterpptx-mcp-fetch-online-assets.mjs",
		"tools/betterpptx-mcp-fetch-iconscout-assets.mjs",
		"tools/betterpptx-mcp-build-iconscout-index.mjs",
		"tools/betterpptx-mcp-frozen-reference-regression.mjs",
		"PPTX_ULTIMATE_DECYPHER_TOOL.mjs",
		"ULTIMATE_PPTX_XPATH_COMPARATOR_v2h_DECYPHER.ps1"
	],
	"types": "types",
	"scripts": {
		"build": "node tools/embed-ui-truth-templates.mjs && rollup -c --bundleConfigAsCjs",
		"start": "gulp",
		"ship": "gulp ship",
		"defs": "gulp reactTestDefs",
		"watch": "rollup -cw",
		"assets:online": "node tools/betterpptx-mcp-fetch-online-assets.mjs",
		"assets:open3d": "node tools/betterpptx-mcp-fetch-open-source-3d-assets.mjs",
		"assets:open3d:quality": "node tools/betterpptx-mcp-build-3d-presentation-derivatives.mjs",
		"assets:open3d:catalog": "node tools/betterpptx-mcp-build-3d-powerpoint-catalog.mjs",
		"assets:iconscout": "node tools/betterpptx-mcp-fetch-iconscout-assets.mjs",
		"assets:iconscout:index": "node tools/betterpptx-mcp-build-iconscout-index.mjs",
		"test:unit": "node --test betterpptx-mcp/test/narration-animation.test.mjs",
		"test:3d-embed-parity": "node betterpptx-mcp/verify-3d-embed-parity.mjs",
		"test:presenter-gesture": "node betterpptx-mcp/verify-presenter-gesture.mjs",
		"test:mcp-authoring-boundary": "node betterpptx-mcp/verify-mcp-json-spec-authoring-boundary-v1.mjs",
		"test:mcp-authoring-live": "node betterpptx-mcp/verify-live-mcp-authoring-pipeline-v1.mjs",
		"test:worlds-save": "node betterpptx-mcp/test/worlds-save.integration.mjs",
		"test:worlds-modes": "node betterpptx-mcp/test/worlds-modes.integration.mjs",
		"test:worlds-emphasis": "node betterpptx-mcp/test/worlds-emphasis.integration.mjs",
		"test:gradient-policy": "node betterpptx-mcp/test/gradient-policy.integration.mjs",
		"test:authoring-capability-registry": "node --test betterpptx-mcp/test/authoring-capability-registry.test.mjs",
		"build:authoring-motion-catalog": "node betterpptx-mcp/build-authoring-motion-catalog.mjs",
		"build:authoring-v3-motion-atlas": "node betterpptx-mcp/build-authoring-v3-motion-atlas.mjs",
		"build:authoring-v3-motion-portfolio": "node betterpptx-mcp/build-authoring-v3-cold-ai-motion-portfolio.mjs",
		"audit:authoring-v3-sources": "node betterpptx-mcp/verify-authoring-v3-source-inventory.mjs && node betterpptx-mcp/verify-authoring-v3-source-availability.mjs",
		"verify:kimodo-authoring-v3": "node betterpptx-mcp/verify-kimodo-authoring-v3-profile.mjs",
		"verify:authoring-v3-motion": "node betterpptx-mcp/verify-authoring-motion-catalog.mjs && node betterpptx-mcp/verify-authoring-motion-bundle.mjs && node betterpptx-mcp/verify-authoring-motion-spec-v1.mjs && node betterpptx-mcp/verify-public-authoring-motion-v1.mjs && node betterpptx-mcp/verify-public-semantic-authoring-v1.mjs --development-no-save && node --test betterpptx-mcp/test/authoring-capability-registry.test.mjs && node betterpptx-mcp/verify-authoring-motion-narration-sync.mjs --development-no-save",
		"verify:authoring-principle": "node tools/verify-authoring-atlas-static-contract.mjs && node tools/verify-authoring-principle-coverage.mjs && node tools/generate-authoring-principle-status-ledger.mjs",
		"verify:cold-ai-mvp-portfolio": "node tools/verify-cold-ai-mvp-portfolio.mjs",
		"build:betterpptx-public": "node tools/build-betterpptx-public-environment.mjs",
		"verify:betterpptx-public-environment": "node tools/verify-betterpptx-public-environment.mjs && node betterpptx-mcp/verify-public-help-progressive-contract-v1.mjs && node betterpptx-mcp/test/public-teaching-depth.test.mjs",
		"verify:betterpptx-public-help": "node betterpptx-mcp/verify-public-help-progressive-contract-v1.mjs",
		"verify:betterpptx-public-teaching-depth": "node betterpptx-mcp/test/public-teaching-depth.test.mjs",
		"verify:betterpptx-public-skill": "node tools/verify-betterpptx-public-skill.mjs",
		"run:betterpptx-public-forward-test": "node tools/run-public-fresh-client-forward-test.mjs",
		"verify:betterpptx-public-forward-test": "node --test tools/test-public-fresh-client-forward-test.mjs",
		"verify:betterpptx-public-tailscale": "node betterpptx-mcp/verify-public-tailscale-acceptance-v1.mjs",
		"verify:mvp-catalog": "node betterpptx-mcp/verify-mvp-baseline-inventory.mjs && node betterpptx-mcp/verify-mvp-baseline-public-contract.mjs && node betterpptx-mcp/verify-authoring-roadmap-status-consistency.mjs",
		"verify:authoring-atlas-static": "node tools/verify-authoring-atlas-static-contract.mjs",
		"verify:authoring-status-ledger": "node tools/generate-authoring-principle-status-ledger.mjs",
		"verify:smartart-corpus": "node tools/verify-smartart-native-corpus.mjs",
		"verify:mcp-smartart-front-door": "node tools/verify-mcp-smartart-front-door.mjs",
		"verify:smartart-editability": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/verify-smartart-editability.ps1",
		"test:mcp-reference": "node tools/betterpptx-mcp-reference-recreation-harness.mjs",
		"test:mcp-reference-legacy": "node tools/betterpptx-mcp-frozen-reference-regression.mjs",
		"convergence:all": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/run-frozen-reference-decypher-visual-corpus.ps1",
		"convergence:status": "node tools/generate-convergence-status.mjs",
		"build:implementation-program": "node tools/build-preset-decomposition-matrix.mjs && node tools/build-implementation-gap-manifest.mjs && node tools/verify-implementation-gap-manifest.mjs",
		"reconcile:implementation-program": "node tools/reconcile-unattended-implementation-state.mjs"
	},
	"browser": {
		"express": false,
		"fs": false,
		"https": false,
		"image-size": false,
		"node:fs": false,
		"node:https": false,
		"os": false,
		"path": false
	},
	"dependencies": {
		"@gltf-transform/core": "^4.3.0",
		"@gltf-transform/extensions": "^4.3.0",
		"@gltf-transform/functions": "^4.5.0",
		"@google-cloud/firestore": "^7.11.6",
		"@google-cloud/storage": "^7.16.0",
		"@google-cloud/tasks": "^6.2.3",
		"@modelcontextprotocol/client": "^2.0.0",
		"@modelcontextprotocol/node": "^2.0.0",
		"@modelcontextprotocol/server": "^2.0.0",
		"@noble/curves": "^1.9.1",
		"@noble/hashes": "^1.8.0",
		"@scure/bip32": "^1.7.0",
		"@scure/bip39": "^1.6.0",
		"@types/node": "^22.8.1",
		"@xmldom/xmldom": "^0.8.15",
		"express": "^5.1.0",
		"google-gax": "^4.6.1",
		"https": "^1.0.0",
		"jszip": "^3.10.1",
		"qrcode": "^1.5.4",
		"sharp": "^0.35.4",
		"svgpath": "^2.6.0",
		"three": "^0.184.0",
		"viem": "^2.56.3",
		"xml2js": "^0.6.2"
	},
	"devDependencies": {
		"@eslint/js": "^9.25.1",
		"@rollup/plugin-commonjs": "^28.0.1",
		"@rollup/plugin-node-resolve": "^16.0.1",
		"@stylistic/eslint-plugin": "^4.2.0",
		"@typescript-eslint/eslint-plugin": "^8.31.0",
		"@typescript-eslint/parser": "^8.31.0",
		"eslint": "^9.25.1",
		"fbx2gltf": "0.9.7-p1",
		"ganache": "^7.9.2",
		"gulp": "^5.0.0",
		"gulp-concat": "^2.6.1",
		"gulp-delete-lines": "0.0.7",
		"gulp-ignore": "^3.0.0",
		"gulp-insert": "^0.5.0",
		"gulp-sourcemaps": "^3.0.0",
		"gulp-uglify": "^3.0.2",
		"image-size": "^1.2.1",
		"meshoptimizer": "^1.2.0",
		"rollup": "^4.24.2",
		"rollup-plugin-typescript2": "^0.36.0",
		"solc": "^0.8.35",
		"tslib": "^2.8.0",
		"typescript": "^5.6.3",
		"typescript-eslint": "^8.31.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/gitbrent/PptxGenJS.git"
	},
	"keywords": [
		"es6-powerpoint",
		"html-to-powerpoint",
		"javascript-create-powerpoint",
		"javascript-create-pptx",
		"javascript-generate-pptx",
		"javascript-powerpoint",
		"javascript-powerpoint-charts",
		"javascript-pptx",
		"js-create-powerpoint",
		"js-create-pptx",
		"js-generate-powerpoint",
		"js-powerpoint",
		"js-powerpoint-library",
		"js-powerpoint-pptx",
		"node-powerpoint",
		"officejs-alternative",
		"react-powerpoint",
		"slide-generator",
		"typescript-powerpoint"
	],
	"bugs": {
		"url": "https://github.com/gitbrent/PptxGenJS/issues"
	},
	"directories": {
		"doc": "docs"
	},
	"type": "commonjs"
}
