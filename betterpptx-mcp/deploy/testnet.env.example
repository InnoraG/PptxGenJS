# BetterPPTX isolated testnet profile.
# Copy this to a private testnet env file and replace every placeholder. Never
# reuse a production RPC credential, PayRam key, relayer key, treasury, bucket,
# or identity/asset approval in this profile.

BETTERPPTX_ENV=staging
BETTERPPTX_DEPLOYMENT_STAGE=testnet
BETTERPPTX_VERIFICATION_POLICY=production-non-rendering
BETTERPPTX_AUTHORITATIVE_POWERPOINT_PREVIEW=0
BETTERPPTX_PUBLIC_BLACK_BOX=1
BETTERPPTX_REQUIRE_EXPLICIT_PAYMENT_NETWORK=1
BETTERPPTX_PAYMENT_NETWORK=base-sepolia
BETTERPPTX_PAYRAM_NETWORK=testnet

# Accountless x402: one exact payment authorizes one bounded job. PayRam is an
# optional testnet wallet-funding/onramp surface, not the x402 settlement rail.
BETTERPPTX_BILLING_PROVIDER=crypto_credits
BETTERPPTX_BILLING_MODEL=pay_per_job
BETTERPPTX_BILLING_ENFORCE=1
BETTERPPTX_MONETIZED_MCP_ENABLED=1
BETTERPPTX_REQUIRE_SHARED_STORES=1
BETTERPPTX_X402_STORE=firestore
BETTERPPTX_X402_RELAYER_LEASE_STORE=firestore
BETTERPPTX_INSTALL_USAGE_STORE=firestore
BETTERPPTX_ENTITLEMENT_STORE=firestore
BETTERPPTX_ASSET_GRANT_STORE=firestore
BETTERPPTX_DURABLE_OPERATION_STORE=firestore
BETTERPPTX_FIRESTORE_DATABASE=(default)
BETTERPPTX_FIRESTORE_BILLING_PREFIX=betterpptx_testnet_billing
BETTERPPTX_FIRESTORE_ENTITLEMENTS_COLLECTION=betterpptx_testnet_entitlements
BETTERPPTX_FIRESTORE_INSTALL_USAGE_COLLECTION=betterpptx_testnet_install_usage
BETTERPPTX_FIRESTORE_ASSET_GRANTS_COLLECTION=betterpptx_testnet_asset_grants

BETTERPPTX_GCP_PROJECT=<new-testnet-gcp-project-id>
BETTERPPTX_PAYMENT_BASE_URL=https://<testnet-public-origin>
BETTERPPTX_PUBLIC_MCP_URL=https://<testnet-public-origin>/mcp
BETTERPPTX_GCS_BUCKET=<testnet-private-artifact-bucket>
BETTERPPTX_ARTIFACT_STORE=gcs
BETTERPPTX_GCS_PREFIX=testnet-artifacts

# Base Sepolia (chain 84532) canonical USDC:
# 0x036CbD53842c5426634e7929541eC2318f3dCF7e
BETTERPPTX_BASE_RPC_URL=<owner-managed-base-sepolia-https-rpc>
BETTERPPTX_TREASURY_EVM_ADDRESS=<owner-managed-testnet-treasury>
BETTERPPTX_X402_SETTLEMENT_MODE=self_settle
BETTERPPTX_X402_RELAYER_PRIVATE_KEY=<test-only-relayer-secret>
BETTERPPTX_X402_RELAYER_KEY_ID=testnet-relayer

# PayRam sandbox/testnet. Configure the PayRam project and webhook separately
# from production, then supply the owner-managed project API key and internal
# BetterPPTX reconcile token through Secret Manager.
BETTERPPTX_PAYRAM_ENABLED=1
BETTERPPTX_PAYRAM_BASE_URL=<payram-testnet-or-sandbox-origin>
BETTERPPTX_PAYRAM_API_KEY=<test-only-payram-project-api-key>
BETTERPPTX_PAYRAM_WEBHOOK_CUSTOM_TOKEN=<test-only-betterpptx-reconcile-token>
BETTERPPTX_PAYRAM_PROJECT_ID=<testnet-payram-project-id>
BETTERPPTX_PAYRAM_TIMEOUT_MS=5000
BETTERPPTX_REQUIRE_CARD_ONRAMP=0

# Keep the testnet single-instance canary conservative until the distributed
# Cloud Run worker/queue profile has been separately qualified.
BETTERPPTX_MCP_MAX_INSTANCES=1
BETTERPPTX_EDIT_STATE_MODE=process-local
BETTERPPTX_EDIT_STATE_SINGLE_INSTANCE_ACCEPTED=1
