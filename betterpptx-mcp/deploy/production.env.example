# betterpptx-mcp — production config.
# Copy to  deploy/production.env  and edit. KEEP THIS FILE SECRET (it holds the
# URL secret). production.env is read by ecosystem.config.cjs (pm2).

# ── Public origin (your stable named-tunnel hostname) ────────────────────────
# This is what download URLs are built from, so it must match the tunnel hostname.
BETTERPPTX_PUBLIC_BASE=https://mcp.YOURDOMAIN.com
BETTERPPTX_ENV=production
BETTERPPTX_DEPLOYMENT_STAGE=production
BETTERPPTX_FREE_PUBLICATIONS_PER_WINDOW=3
BETTERPPTX_FREE_PUBLICATION_WINDOW_DAYS=30
BETTERPPTX_FREE_IDENTITY_MEDIA_PER_WINDOW=3
# Production cloud delivery intentionally uses deterministic non-rendering
# validation. PowerPoint is a release-qualification dependency only.
BETTERPPTX_VERIFICATION_POLICY=production-non-rendering
# Production must name its payment chain explicitly. Testnet uses a separate
# deployment profile and separate PayRam/API/RPC/treasury credentials.
BETTERPPTX_REQUIRE_EXPLICIT_PAYMENT_NETWORK=1
BETTERPPTX_PAYMENT_NETWORK=base-mainnet
BETTERPPTX_PAYRAM_NETWORK=mainnet

# ── Verified account authentication ────────────────────────────────────────
# Public protected operations fail closed regardless of legacy none/path flags.
# Anonymous discovery does not grant private resources, publication or media work.
BETTERPPTX_AUTH=oauth
BETTERPPTX_URL_SECRET=
# Self-hosted setup: follow docs/SELF-HOSTED-IDENTITY.md, then enable this switch.
# The HTTP launcher reads the owner-protected identity key; never paste it here.
BETTERPPTX_SELF_HOSTED_IDENTITY=0
# Alternative owner-managed OAuth deployment needs exact issuer/resource/JWKS
# and a dedicated secret from private secret storage. Never infer them from tokens.
# BETTERPPTX_OAUTH_ISSUER=https://identity.example/issuer
# BETTERPPTX_OAUTH_AUDIENCE=https://mcp.YOURDOMAIN.com/mcp
# BETTERPPTX_OAUTH_JWKS_URL=https://identity.example/issuer/jwks
# BETTERPPTX_OAUTH_TOKEN_PROFILE=rfc9068
# Required with the keycloak token profile; pin it to the authorized client.
# BETTERPPTX_OAUTH_CLIENT_ID=https://chatgpt.com/oauth/client.json

# ── Local bind (cloudflared connects here; do NOT expose this port directly) ──
BETTERPPTX_HOST=127.0.0.1
BETTERPPTX_PORT=3344

# ── Downloads ────────────────────────────────────────────────────────────────
BETTERPPTX_DOWNLOAD_ROOT=C:\MyDoc\PptxGenJS_Claude\outputs\public_files
BETTERPPTX_DOWNLOAD_BUDGET_MB=2048

# ── Capacity guards (tune to the box: 1vCPU/1GB→20/2, 4vCPU/8GB→120/6) ────────
BETTERPPTX_MAX_DECKS=60
BETTERPPTX_DECK_TTL_MS=1800000
BETTERPPTX_MAX_CONCURRENCY=4
BETTERPPTX_MAX_QUEUE=64
BETTERPPTX_JSON_LIMIT=50mb

# On a Windows/PowerPoint release-qualification host, use
# BETTERPPTX_VERIFICATION_POLICY=release-powerpoint and enable the renderer.
# Do not enable this merely to make production cloud save depend on Office.
# BETTERPPTX_AUTHORITATIVE_POWERPOINT_PREVIEW=1
# Production rejects forced premium, simulated billing, and any billing model
# other than the accountless x402 one-payment-per-bounded-job contract. PayRam
# can remain an optional wallet-funding/onramp surface; it is not job settlement.
# BETTERPPTX_TTS_URL=http://127.0.0.1:5000

# ── Production accountless x402 pay-per-job / optional PayRam onramp ─────────
# These non-secret switches select the production contract. The required
# shared stores and owner-managed secrets below must still be installed and
# verified before public billing is enabled.
#
# BETTERPPTX_BILLING_PROVIDER=crypto_credits
# BETTERPPTX_BILLING_MODEL=pay_per_job
# BETTERPPTX_BILLING_ENFORCE=1
# BETTERPPTX_MONETIZED_MCP_ENABLED=1
# BETTERPPTX_REQUIRE_SHARED_STORES=1
# The legacy compatibility stores below are not a customer balance for new
# jobs. They remain explicit until the compatibility HTTP payment routes and
# boot probe are made pay-per-job aware.
# BETTERPPTX_BILLING_LEDGER_STORE=firestore
# BETTERPPTX_CRYPTO_ORDER_STORE=firestore
# BETTERPPTX_X402_STORE=firestore
# BETTERPPTX_X402_RELAYER_LEASE_STORE=firestore
# BETTERPPTX_INSTALL_USAGE_STORE=firestore
# BETTERPPTX_ENTITLEMENT_STORE=firestore
# BETTERPPTX_ASSET_GRANT_STORE=firestore
# BETTERPPTX_FIRESTORE_ASSET_GRANTS_COLLECTION=betterpptx_asset_grants
# BETTERPPTX_DURABLE_OPERATION_STORE=firestore
# BETTERPPTX_REQUIRE_DURABLE_OPERATION_IDEMPOTENCY=1
# BETTERPPTX_GCP_PROJECT=your-gcp-project
# BETTERPPTX_FIRESTORE_DATABASE=(default)
# BETTERPPTX_FIRESTORE_BILLING_COLLECTION_PREFIX=betterpptx_billing
# BETTERPPTX_PAYMENT_BASE_URL=https://mcp.YOURDOMAIN.com
# BETTERPPTX_PUBLIC_MCP_URL=https://mcp.YOURDOMAIN.com/mcp
# BETTERPPTX_PAYRAM_ENABLED=1
# BETTERPPTX_REQUIRE_CARD_ONRAMP=0
# BETTERPPTX_PAYRAM_BASE_URL=https://payram.YOURDOMAIN.com
# BETTERPPTX_PAYRAM_TIMEOUT_MS=5000
# BETTERPPTX_PAYRAM_EXACT_QUOTE_ENABLED=0
# BETTERPPTX_PAYRAM_PARTIAL_CREDIT_POLICY=none
# Promo codes are BetterPPTX-owned server-side configuration. Do not put them
# in a public MCP request schema, the PayRam checkout, source control, or logs.
# Example shape (replace with an owner-managed Secret Manager value):
# Template only: replace the code and customer hash with privately issued values.
# Production requires a finite issued customer audience and a redemption cap;
# "one per installation" alone cannot prevent reinstall/multiple-identity abuse.
# BETTERPPTX_PROMO_CODES_JSON={"codes":[{"id":"issued-500","code":"REPLACE-PRIVATE-CODE","packId":"starter_500","percentOff":100,"maxRedemptions":1,"maxPerCustomer":1,"customerHashes":["REPLACE-ISSUED-BILLING-IDENTITY"]}]}
# BETTERPPTX_PROMO_STORE_FILE=outputs/betterpptx-promo-redemptions.json
#
# Store these as owner-managed secrets, not in source control or public MCP
# responses. The PayRam project API key is used for create/status calls and
# for authenticating PayRam's webhook header. The custom webhook token is a
# separate BetterPPTX-only credential for internal reconcile/scanner calls.
# BETTERPPTX_PAYRAM_API_KEY=<owner-managed secret>
# BETTERPPTX_PAYRAM_WEBHOOK_CUSTOM_TOKEN=<owner-managed secret>
# BETTERPPTX_PAYMENT_ENVELOPE_SECRET=<owner-managed secret>
# BETTERPPTX_INSTALL_HMAC_SECRET=<owner-managed secret>
# An optional separate state-signing key; otherwise the private install HMAC key
# is used. Never use a client bearer token as the server's signing secret.
# BETTERPPTX_MCP_V2_STATE_SECRET=<owner-managed secret>
# BETTERPPTX_TREASURY_EVM_ADDRESS=<owner-managed Base address>
# BETTERPPTX_BASE_RPC_URL=<owner-managed Base mainnet HTTPS RPC>
# BETTERPPTX_X402_RELAYER_PRIVATE_KEY=<owner-managed secret>
# BETTERPPTX_DEPOSIT_XPUB_JSON=<owner-managed secret/config>
#
# After PayRam is ready, set its project webhook endpoint to:
# https://mcp.YOURDOMAIN.com/internal/payments/payram/webhook
# PayRam's documented API-Key header is accepted for that webhook. The
# BetterPPTX custom token is not a PayRam dashboard value.


# ── Development traffic logging ─────────────────────────────────────────────
# Disabled by default. Use `debug` for redacted structured events, or `full` for
# complete JSON payload logging. Auth/cookie/token values and /s/<secret>/mcp
# URL path secrets and payloads remain redacted in production even if a
# development logging override is accidentally inherited. Full production log
# records are bounded; these debug logs are not the authoritative billing ledger.
BETTERPPTX_LOG=
# Optional private operator diagnostics: schemas are fingerprinted; no payloads or credentials.
BETTERPPTX_DIAGNOSTIC_TRACE=
BETTERPPTX_DIAGNOSTIC_TRACE_DIR=
BETTERPPTX_LOG_DIR=C:\MyDoc\PptxGenJS_Claude\logs\betterpptx-mcp
BETTERPPTX_LOG_MAX_CHARS=

# Per-process traffic ceilings also apply when the endpoint is unauthenticated.
# These are abuse controls, NOT a distributed monetary spending guarantee.
BETTERPPTX_RATE_LIMIT_BURST=120
BETTERPPTX_RATE_LIMIT_REFILL_PER_MIN=120
BETTERPPTX_RATE_LIMIT_GLOBAL_BURST=1200
BETTERPPTX_RATE_LIMIT_GLOBAL_REFILL_PER_MIN=1200
# Forwarded IPs are ignored unless the immediate peer is explicitly trusted.
# List actual fixed reverse-proxy addresses, never arbitrary client addresses.
# BETTERPPTX_TRUST_PROXY_HEADERS=1
# BETTERPPTX_TRUSTED_PROXY_ADDRESSES=127.0.0.1,::1

# pm2 hard memory ceiling — restart the server if it exceeds this.
BETTERPPTX_MAX_MEMORY_RESTART=900M

# Durable source/deck heads. A single-host named development endpoint may use
# local files; multi-worker/cloud production must use Firestore + GCS instead.
# BETTERPPTX_DURABLE_DECK_STATE_STORE=local
# BETTERPPTX_DECK_STATE_FILE=D:/PptxGenJS_Claude/outputs/public_runtime/betterpptx-deck-state.json
# BETTERPPTX_DECK_SNAPSHOT_STORE=local
# BETTERPPTX_DECK_SNAPSHOT_DIR=D:/PptxGenJS_Claude/outputs/public_runtime/deck-snapshots
# BETTERPPTX_REQUIRE_DURABLE_DECK_STATE=0

# ── Tunnel selection ─────────────────────────────────────────────────────────
# TUNNEL = tailscale | cloudflared | quick | none
#   tailscale   → NO domain needed. tailscaled owns the public Funnel + persists
#                 it across reboots; pm2 runs only the server. Stable *.ts.net URL.
#                 Set up once via setup-tailscale-funnel.ps1, then set PUBLIC_BASE
#                 to the printed https://<device>.<tailnet>.ts.net URL.
#   cloudflared → needs a domain on Cloudflare; pm2 runs the named tunnel too.
#   quick       → ephemeral cloudflared URL (changes each boot) — testing only.
#   none        → you front the local port with your own HTTPS.
TUNNEL=tailscale

# Cloudflared named-tunnel settings (only used when TUNNEL=cloudflared):
CLOUDFLARED_TUNNEL_NAME=
CLOUDFLARED_CONFIG=C:\MyDoc\PptxGenJS_Claude\betterpptx-mcp\deploy\cloudflared-config.yml
# Optional private, tunnel-specific credentials JSON. Keep outside the repository.
CLOUDFLARED_CREDENTIALS_FILE=
