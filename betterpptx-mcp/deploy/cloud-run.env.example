# BetterPPTX Cloud Run private production template.
# Private Track A only. Do not copy this file to the public docs repo.
#
# Cloud Run sets PORT automatically. Set BETTERPPTX_HOST=0.0.0.0 so the
# container accepts traffic from the Cloud Run proxy.
#
# Configure Cloud Run max instances = 1 for the first private deployment.
# GCS artifacts and Firestore entitlements are shared, but the live editable
# deck/session registry is still process-local until cross-instance deck/session
# state is implemented and verified.

BETTERPPTX_HOST=0.0.0.0
BETTERPPTX_AUTH=none
BETTERPPTX_PUBLIC_BLACK_BOX=1
BETTERPPTX_PUBLIC_BASE=https://REPLACE-WITH-CLOUD-RUN-OR-DOMAIN
BETTERPPTX_PUBLIC_MCP_URL=https://REPLACE-WITH-CLOUD-RUN-OR-DOMAIN/mcp

# Dodo live billing. Store DODO_PAYMENTS_API_KEY and webhook secret in Secret
# Manager, not in GitHub or this file.
BETTERPPTX_BILLING_PROVIDER=dodo
BETTERPPTX_DODO_VALIDATE_URL=https://live.dodopayments.com/licenses/validate
BETTERPPTX_LICENSE_VALIDATION_MODE=auto
BETTERPPTX_PRICING_URL=https://betterpptx.com/pricing
BETTERPPTX_CHECKOUT_URL=https://betterpptx.com/pricing
BETTERPPTX_PORTAL_URL=https://betterpptx.com/pricing

# GCS artifact storage. Bucket must be private and lifecycle-delete artifacts
# after the chosen TTL. Runtime service account needs object create/read plus
# service-account signing permission for V4 signed URLs.
BETTERPPTX_ARTIFACT_STORE=gcs
BETTERPPTX_GCS_BUCKET=REPLACE-WITH-PRIVATE-BUCKET
BETTERPPTX_GCS_PREFIX=artifacts
BETTERPPTX_ARTIFACT_TTL_MS=43200000

# Firestore entitlement state. Stores license-key fingerprints and provider
# state only; never raw activation keys. This does not yet make live deck state
# cross-instance safe.
BETTERPPTX_ENTITLEMENT_STORE=firestore
BETTERPPTX_FIRESTORE_DATABASE=(default)
BETTERPPTX_FIRESTORE_ENTITLEMENTS_COLLECTION=betterpptx_entitlements

# Force production to fail fast if a deploy accidentally falls back to local
# disk or local entitlement files.
BETTERPPTX_REQUIRE_SHARED_STORES=1

# Public cost and abuse controls.
BETTERPPTX_RATE_LIMIT_BURST=120
BETTERPPTX_RATE_LIMIT_REFILL_PER_MIN=120
BETTERPPTX_SESSION_DECKS_PER_HOUR=20
BETTERPPTX_MAX_DECKS=60
BETTERPPTX_DECK_TTL_MS=1800000
BETTERPPTX_MAX_CONCURRENCY=4
BETTERPPTX_MAX_QUEUE=64
BETTERPPTX_JSON_LIMIT=40mb
BETTERPPTX_MAX_UPLOAD_BYTES=41943040
BETTERPPTX_TOOL_TIMEOUT_MS=120000

# Generic HTTP fetch stays disabled. Media/image fetches still use the safe
# fetch layer.
BETTERPPTX_ENABLE_GENERIC_HTTP_FETCH=0

# Sketchfab live model import. Store the single installed Sketchfab API key in
# Secret Manager and expose it to Cloud Run as SKETCHFAB_API_KEY. Search/inspect
# can run without it; model import requires it.
BETTERPPTX_SKETCHFAB_CACHE_DIR=/tmp/betterpptx-sketchfab-assets

# Production logging: keep payload/path logging off unless diagnosing privately.
BETTERPPTX_LOG=
BETTERPPTX_LOG_PAYLOADS=0
BETTERPPTX_LOG_PATHS=0
