# BetterPPTX Cloud Run accountless x402 pay-per-job deployment.
# Billing-critical values are Secret Manager bindings configured by
# your private deployment automation. Do not put their raw values here.
# This active profile enables distributed payment coordination for a private
# canary while interactive deck state remains process-local. Public production /
# GA requires the distributed runtime block below plus the section-29/34 gates in
# plans/fluora-monetizedmcp-*-codexpreview.md.
# Settlement mode: self_settle.
# The isolated BetterPPTX relayer must retain a small Base ETH gas reserve.

BETTERPPTX_HOST=0.0.0.0
BETTERPPTX_AUTH=none
BETTERPPTX_PUBLIC_BLACK_BOX=1
BETTERPPTX_PUBLIC_BASE=https://REPLACE-WITH-CLOUD-RUN-OR-DOMAIN
BETTERPPTX_PAYMENT_BASE_URL=https://REPLACE-WITH-CLOUD-RUN-OR-DOMAIN
BETTERPPTX_PUBLIC_MCP_URL=https://REPLACE-WITH-CLOUD-RUN-OR-DOMAIN/mcp

# This template is the production/mainnet profile. Testnet must use the
# separate testnet.env.example profile and separate credentials/treasury.
BETTERPPTX_REQUIRE_EXPLICIT_PAYMENT_NETWORK=1
BETTERPPTX_PAYMENT_NETWORK=base-mainnet
BETTERPPTX_PAYRAM_NETWORK=mainnet

BETTERPPTX_BILLING_PROVIDER=crypto_credits
BETTERPPTX_BILLING_MODEL=pay_per_job
BETTERPPTX_BILLING_ENFORCE=1
BETTERPPTX_MONETIZED_MCP_ENABLED=1
# New jobs are authorized by an exact x402 payment bound to that job. The
# accountless pay-per-job profile intentionally does not configure a reusable
# customer-credit ledger or the legacy credit-order store. Those routes return
# PAY_PER_JOB_ROUTE_ONLY and are available only in an explicitly selected
# credit_compatibility deployment. Durable records for this profile are the
# x402 quote/job binding, settlement evidence, execution lease, usage,
# entitlement, asset-grant, and artifact stores below.
BETTERPPTX_X402_STORE=firestore
BETTERPPTX_X402_RELAYER_LEASE_STORE=firestore
BETTERPPTX_INSTALL_USAGE_STORE=firestore
BETTERPPTX_ENTITLEMENT_STORE=firestore
BETTERPPTX_ASSET_GRANT_STORE=firestore
BETTERPPTX_FIRESTORE_ASSET_GRANTS_COLLECTION=betterpptx_asset_grants
BETTERPPTX_REQUIRE_SHARED_STORES=1
BETTERPPTX_FIRESTORE_DATABASE=(default)
BETTERPPTX_FIRESTORE_BILLING_PREFIX=betterpptx_billing
BETTERPPTX_FIRESTORE_ENTITLEMENTS_COLLECTION=betterpptx_billing_entitlements
BETTERPPTX_FIRESTORE_INSTALL_USAGE_COLLECTION=betterpptx_install_daily_usage

BETTERPPTX_ARTIFACT_STORE=gcs
BETTERPPTX_GCS_BUCKET=REPLACE-WITH-PRIVATE-BUCKET
BETTERPPTX_GCS_PREFIX=artifacts
BETTERPPTX_ARTIFACT_TTL_MS=43200000
# Run the private `node betterpptx-mcp/sweep-cloud-artifacts.mjs` entry point
# hourly with this same bucket/prefix, using a restricted service identity.
# Signed links expire sooner than artifacts. GCS day-granularity lifecycle
# rules do not enforce this 12-hour TTL; a scheduled sweep is required.
# Newly written objects carry an explicit expiry tag. Legacy untagged objects
# are intentionally excluded and need a separately reviewed migration.

# Read-only ASSET CATALOG root (Microsoft Stock 3D + ToxSam/Khronos/IconScout GLBs,
# Lucide icons, shape scenes). The catalog loader resolves outputs/microsoft_stock3d_library
# and demos/betterpptx-* against this root. Locally it defaults to the process CWD (repo root)
# so nothing changes. In the cloud, mount the asset bundle via gcsfuse (same pattern as the
# Piper voices and avatar /models mounts) and point this at the mount, e.g. /assets — the dir
# must contain outputs/microsoft_stock3d_library/ and demos/betterpptx-online-assets/ etc.
# The catalog loader, ranking, handle scheme (model3d://…), and catalog-first selection are
# then byte-for-byte identical to local; only the asset bytes' location is env-selected.
# Use a dedicated persistent assets bucket. Do not reuse a transient artifact bucket with a
# short lifecycle-delete rule.
# BETTERPPTX_ASSETS_ROOT=/assets

# Request concurrency is for lightweight/control/payment HTTP traffic. Heavy deck
# execution remains limited by BETTERPPTX_MAX_CONCURRENCY below.
BETTERPPTX_MCP_REQUEST_CONCURRENCY=8
BETTERPPTX_MCP_MAX_INSTANCES=1
BETTERPPTX_EDIT_STATE_MODE=process-local
BETTERPPTX_EDIT_STATE_SINGLE_INSTANCE_ACCEPTED=1
BETTERPPTX_MAX_CONCURRENCY=1
# Heavy admission anti-starvation (section 31.5): a heavy request waiting on the
# heavy semaphore still holds a Cloud Run request slot. Heavy slot-holders =
# MAX_CONCURRENCY + MAX_QUEUE must stay BELOW MCP_REQUEST_CONCURRENCY so a heavy
# burst cannot consume every slot and starve payment/status/discovery. Here
# 1 + 3 = 4 of 8 slots are the heavy ceiling, reserving 4 for control/payment;
# excess heavy requests fail fast with BUSY instead of camping on a slot.
BETTERPPTX_MAX_QUEUE=3
BETTERPPTX_TOOL_TIMEOUT_MS=300000
# Long-running GPU/render tools (generate_rigged3d, generate_model3d, sketchfab.import, avatar.render_job,
# deck/slide.add_avatar_narration) spawn+poll an external worker whose cold chain runs for minutes — well
# past the 300s default above. They get this larger in-process ceiling so the provider's own poll deadline
# (BETTERPPTX_MODEL3D_POLL_DEADLINE_MS, default 1_200_000) fires first with a clean, metered error rather
# than a bare TOOL_TIMEOUT. Keep this ABOVE that poll deadline. NOTE: this is only the in-process ceiling —
# the Cloud Run request timeout must ALSO be raised (gcloud run ... --timeout) for the HTTP transport to
# survive these calls; the platform default (300s) would cut them off before this ever fires.
BETTERPPTX_LONG_TOOL_TIMEOUT_MS=1500000

# Public production target posture, disabled in this private-canary profile:
# - stateless Streamable HTTP MCP routing;
# - Firestore operation ledger with idempotency, leases, and fencing;
# - Cloud Tasks dispatch to autoscaled private workers;
# - Firestore deck heads plus private GCS canonical deck-spec blobs;
# - private GCS shared locked/opaqueNative asset blobs;
# - distributed runtime/failure campaign explicitly verified before readiness.
#
# BETTERPPTX_HTTP_STATELESS_MCP=1
# BETTERPPTX_MCP_MAX_INSTANCES=REPLACE-WITH-COST-AND-QUOTA-POLICY
# BETTERPPTX_EDIT_STATE_MODE=distributed
# BETTERPPTX_DURABLE_OPERATION_STORE=firestore
# BETTERPPTX_OPERATION_DISPATCHER=cloud-tasks
# BETTERPPTX_OPERATION_WORKER_URL=https://REPLACE-WITH-DECK-WORKER-DOMAIN
# BETTERPPTX_OPERATION_WORKER_SERVICE_ACCOUNT=REPLACE-WITH-WORKER-INVOKER-SA
# BETTERPPTX_OPERATION_WORKER_TOKEN=secret-manager:betterpptx-operation-worker-token
# BETTERPPTX_CLOUD_TASKS_LOCATION=REPLACE-WITH-REGION
# BETTERPPTX_CLOUD_TASKS_QUEUE_DECK_INTERACTIVE=betterpptx-deck-interactive
# BETTERPPTX_CLOUD_TASKS_QUEUE_DECK_BATCH=betterpptx-deck-batch
# BETTERPPTX_CLOUD_TASKS_QUEUE_MEDIA=betterpptx-media-long
# BETTERPPTX_REQUIRE_DISTRIBUTED_OPERATION_DISPATCH=1
# BETTERPPTX_REQUIRE_DURABLE_OPERATION_IDEMPOTENCY=1
# BETTERPPTX_DURABLE_DECK_STATE_STORE=firestore-gcs
# BETTERPPTX_DECK_SNAPSHOT_STORE=gcs
# BETTERPPTX_DECK_SNAPSHOT_GCS_PREFIX=deck-specs
# BETTERPPTX_LOCKED_ASSET_STORE=gcs
# BETTERPPTX_LOCKED_ASSET_GCS_PREFIX=locked-assets
# BETTERPPTX_DISTRIBUTED_RUNTIME_VERIFIED=0

BETTERPPTX_PAYMENT_STATUS_SCAN_INTERVAL_MS=15000
BETTERPPTX_PAYRAM_ENABLED=0
BETTERPPTX_REQUIRE_CARD_ONRAMP=0
BETTERPPTX_PAYRAM_TIMEOUT_MS=5000
BETTERPPTX_PAYRAM_EXACT_QUOTE_ENABLED=0
BETTERPPTX_PAYRAM_PARTIAL_CREDIT_POLICY=none
# Required final card-to-crypto rail, disabled until PayRam Phase 0 proofs pass:
# Set BETTERPPTX_PAYRAM_ENABLED=1 only after the owner has completed the
# PayRam project/API/webhook and evidence checks. The project API key is the
# runtime BetterPPTX -> PayRam credential; it is not a client-facing secret.
# BETTERPPTX_PAYRAM_BASE_URL=secret-manager:betterpptx-payram-base-url
# BETTERPPTX_PAYRAM_API_KEY=secret-manager:betterpptx-payram-api-key
# BETTERPPTX_PAYRAM_WEBHOOK_CUSTOM_TOKEN=secret-manager:betterpptx-payram-webhook-custom-token
# BETTERPPTX_PAYRAM_PROJECT_ID=secret-manager:betterpptx-payram-project-id
# Owner-managed BetterPPTX promo registry; never put raw campaign codes in the
# public MCP schema or PayRam payment metadata:
# BETTERPPTX_PROMO_CODES_JSON=secret-manager:betterpptx-promo-codes
# Do not bind betterpptx-payram-hot-wallet-private-key to the Cloud Run MCP runtime.

# Raw-send direct crypto is xpub/private-canary until CREATE2 forwarder proof,
# Base Sepolia proof, and capped live-value mainnet canary pass.
BETTERPPTX_RAW_SEND_RAIL=xpub
# Production raw-send forwarder rail, bind only after Phase 0B proof:
# BETTERPPTX_RAW_SEND_RAIL=forwarder
# BETTERPPTX_FORWARDER_FACTORY_ADDRESS=secret-manager:betterpptx-forwarder-factory-address
# BETTERPPTX_FORWARDER_CODEHASH=secret-manager:betterpptx-forwarder-codehash
# BETTERPPTX_SETTLEMENT_COLLECTOR_EVM_ADDRESS=secret-manager:betterpptx-settlement-collector-evm-address
# BETTERPPTX_FORWARDER_SALT_SECRET=secret-manager:betterpptx-forwarder-salt-secret
# BETTERPPTX_FORWARDER_SWEEPER_KEY=secret-manager:betterpptx-forwarder-sweeper-key
# BETTERPPTX_FORWARDER_BATCH_SIZE=25
# BETTERPPTX_FORWARDER_CANARY_MAX_USDC=0
# BETTERPPTX_FORWARDER_SWEEP_MAX_ORDERS=500
# BETTERPPTX_FORWARDER_SWEEP_HOT_WINDOW_DAYS=30

BETTERPPTX_BASE_SCAN_BLOCK_WINDOW=5000
BETTERPPTX_BASE_LAZY_SCAN_BLOCK_WINDOW=5000
BETTERPPTX_BASE_SAFE_DEPTH=2
# Depth is not mainnet financial finality. Production settlement additionally
# requires the RPC's finalized boundary and canonical receipt block hash.
# Operator-funded gas may still be lost when a signed payment later reverts;
# this profile does not establish a zero-loss guarantee or authorize launch.
BETTERPPTX_X402_SETTLEMENT_MODE=self_settle
BETTERPPTX_X402_RELAYER_KEY_ID=primary
BETTERPPTX_X402_RELAYER_LEASE_TTL_MS=15000
BETTERPPTX_X402_RELAYER_LEASE_WAIT_MS=10000
BETTERPPTX_X402_SERVICE_FULFILLMENT_LEASE_MS=120000

BETTERPPTX_MISSION_CONTROL=1
BETTERPPTX_MC_SECRET_BACKEND=gcp-secret-manager
BETTERPPTX_GCP_PROJECT=REPLACE-WITH-PROJECT

# Owner-private Mission Control proof evidence. These do not enable PayRam or
# forwarder raw-send by themselves; they only make public-enable proof status
# visible to Mission Control after the external drills/canaries are complete.
# Use ISO timestamps for owner-accepted proof stamps, or point to redacted JSON
# evidence files produced by the proof tools when the runtime can read them.
# BETTERPPTX_PAYRAM_OCI_HOST_VERIFIED_AT=2026-06-17T00:00:00.000Z
# BETTERPPTX_PAYRAM_OCI_HOST_EVIDENCE_FILE=/workspace/outputs/payram-oci-host-proof/latest.json
# BETTERPPTX_PAYRAM_DNS_HTTPS_VERIFIED_AT=2026-06-17T00:00:00.000Z
# BETTERPPTX_PAYRAM_DNS_HTTPS_EVIDENCE_FILE=/workspace/outputs/payram-dns-https-proof/latest.json
# BETTERPPTX_PAYRAM_BACKUP_RESTORE_VERIFIED_AT=2026-06-17T00:00:00.000Z
# BETTERPPTX_PAYRAM_BACKUP_RESTORE_EVIDENCE_FILE=/workspace/outputs/payram-backup-restore-proof/latest.json
# BETTERPPTX_PAYRAM_OCI_ALARMS_VERIFIED_AT=2026-06-17T00:00:00.000Z
# BETTERPPTX_PAYRAM_OCI_ALARMS_EVIDENCE_FILE=/workspace/outputs/payram-oci-alarms-proof/latest.json
# BETTERPPTX_PAYRAM_PHASE0_VERIFIED_AT=2026-06-17T00:00:00.000Z
# BETTERPPTX_PAYRAM_PHASE0_EVIDENCE_FILE=/workspace/outputs/payram-phase0-proof/latest.json
# BETTERPPTX_FORWARDER_CUSTODY_VERIFIED_AT=2026-06-17T00:00:00.000Z
# BETTERPPTX_FORWARDER_CUSTODY_EVIDENCE_FILE=/workspace/outputs/forwarder-custody/latest-manifest.json
# BETTERPPTX_FORWARDER_PROOF_VERIFIED_AT=2026-06-17T00:00:00.000Z
# BETTERPPTX_FORWARDER_PROOF_EVIDENCE_FILE=/workspace/outputs/forwarder-proof/latest.json
# BETTERPPTX_FORWARDER_REVIEW_VERIFIED_AT=2026-06-17T00:00:00.000Z
# BETTERPPTX_FORWARDER_REVIEW_EVIDENCE_FILE=/workspace/outputs/forwarder-review/latest.json

BETTERPPTX_RATE_LIMIT_BURST=120
BETTERPPTX_RATE_LIMIT_REFILL_PER_MIN=120
BETTERPPTX_RATE_LIMIT_GLOBAL_BURST=1200
BETTERPPTX_RATE_LIMIT_GLOBAL_REFILL_PER_MIN=1200
BETTERPPTX_ENABLE_GENERIC_HTTP_FETCH=0
BETTERPPTX_LOG=
BETTERPPTX_LOG_PAYLOADS=0
BETTERPPTX_LOG_PATHS=0
