# BetterPPTX avatar narration container config.
# Copy to a private env file and edit for the chosen deployment.

BETTERPPTX_HOST=0.0.0.0
BETTERPPTX_PORT=3344
BETTERPPTX_PUBLIC_BLACK_BOX=1
BETTERPPTX_PUBLIC_BASE=https://REPLACE-WITH-PUBLIC-ORIGIN
BETTERPPTX_PUBLIC_MCP_URL=https://REPLACE-WITH-PUBLIC-ORIGIN/mcp

# ffmpeg/ffprobe are installed in the BetterPPTX container by deploy/Dockerfile.
BETTERPPTX_FFMPEG_PATH=/usr/bin/ffmpeg
BETTERPPTX_FFPROBE_PATH=/usr/bin/ffprobe

# Packaging-only smoke mode. It proves PowerPoint-safe MP4 insertion but is not
# lip-sync. Use this for CI and local container readiness.
BETTERPPTX_AVATAR_PROVIDER=test-static
BETTERPPTX_AVATAR_DEVELOPMENT_MODE=1

# Final production lane (owner-approved commercial master): upstream LivePortrait
# InsightFace alignment + upstream MuseTalk BiSeNet parsing. Public schemas expose
# only quality/mode; provider ids remain private deployment configuration.
# BETTERPPTX_AVATAR_PROVIDER=liveportrait-musetalk-commercial
# BETTERPPTX_AVATAR_PRODUCTION_ONLY=1
# BETTERPPTX_AVATAR_PRODUCTION_MOTION_PROFILE=blink
# BETTERPPTX_AVATAR_PRODUCTION_MOUTH_PROFILE=jaw
# BETTERPPTX_COMMERCIAL_AVATAR_WORKER_URL=https://COMMERCIAL-WORKER-ENDPOINT
# BETTERPPTX_COMMERCIAL_AVATAR_WORKER_ROUTE=/v1/avatar/lipsync
# BETTERPPTX_COMMERCIAL_AVATAR_WORKER_TOKEN=SET-IN-SECRET-MANAGER

# Alternate lanes are development/research fixtures only. They must never be
# configured as a production fallback for talking-head delivery.
# BETTERPPTX_AVATAR_PROVIDER=musetalk
# BETTERPPTX_AVATAR_WORKER_URL=http://avatar-musetalk-worker:7860
# BETTERPPTX_AVATAR_WORKER_ROUTE=/v1/avatar/lipsync
# BETTERPPTX_AVATAR_WORKER_TOKEN=SET-IN-SECRET-MANAGER

# SadTalker CLI is intended for a private worker image, not the Node MCP image.
# BETTERPPTX_AVATAR_PROVIDER=sadtalker
# BETTERPPTX_SADTALKER_DIR=/opt/sadtalker
# BETTERPPTX_SADTALKER_ENTRYPOINT=/opt/sadtalker/inference.py
# BETTERPPTX_SADTALKER_PYTHON=/opt/venv/bin/python

BETTERPPTX_AVATAR_MAX_CONCURRENCY=1
BETTERPPTX_AVATAR_MAX_SECONDS=120
BETTERPPTX_AVATAR_TIMEOUT_MS=600000
BETTERPPTX_AVATAR_CACHE_DIR=/var/lib/betterpptx/avatar
BETTERPPTX_AVATAR_CACHE_TTL_MS=2592000000
BETTERPPTX_AVATAR_CACHE_MAX_MB=10240
BETTERPPTX_AVATAR_JOB_TTL_MS=86400000
BETTERPPTX_AVATAR_JOB_MAX_MB=20480

# Avatar rendering is always premium/heavy. Configure billing before exposing
# model-backed rendering publicly.
BETTERPPTX_BILLING_PROVIDER=dodo
BETTERPPTX_BILLING_ENFORCE=1
