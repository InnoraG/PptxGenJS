        {
          "objectName": "signal",
          "type": "exit",
          "effect": "fade",
          "trigger": "afterPrevious",
          "durationMs": 300
        },
        {
          "objectName": "signal",
          "type": "entrance",
          "effect": "fade",
          "trigger": "afterPrevious",
          "delayMs": 500,
          "durationMs": 300
