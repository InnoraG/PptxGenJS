{
  "title": "BetterPPTX developer-to-public teaching-gap ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "isTemplate",
    "truthState",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": "betterpptx-developer-public-teaching-gap-ledger.v1"
    },
    "isTemplate": {
      "type": "boolean"
    },
    "truthState": {
      "type": "string",
      "enum": [
        "empty-template-no-promoted-lessons",
        "development-evidence-ledger",
        "release-bound-evidence-ledger"
      ]
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "isTemplate": {
            "const": true
          }
        },
        "required": [
          "isTemplate"
        ]
      },
      "then": {
        "properties": {
          "truthState": {
            "const": "empty-template-no-promoted-lessons"
          },
          "entries": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "truthState": {
            "const": "empty-template-no-promoted-lessons"
          }
        },
        "required": [
          "truthState"
        ]
      },
      "then": {
        "properties": {
          "isTemplate": {
            "const": true
          },
          "entries": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "truthState": {
            "enum": [
              "development-evidence-ledger",
              "release-bound-evidence-ledger"
            ]
          }
        },
        "required": [
          "truthState"
        ]
      },
      "then": {
        "properties": {
          "isTemplate": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "truthState": {
            "const": "release-bound-evidence-ledger"
          }
        },
        "required": [
          "truthState"
        ]
      },
      "then": {
        "properties": {
          "entries": {
            "minItems": 1,
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/entry"
                },
                {
                  "properties": {
                    "state": {
                      "const": "verified"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gapId",
        "state",
        "classification",
        "originEvidence",
        "generalizedLesson",
        "target",
        "forwardTest",
        "releaseBinding",
        "sealedPromptMaterialPresent",
        "privateDetailsPresent"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "verified"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "forwardTest": {
                "properties": {
                  "state": {
                    "const": "passed"
                  },
                  "resultEvidenceSha256": {
                    "$ref": "#/$defs/sha256"
                  }
                }
              },
              "releaseBinding": {
                "properties": {
                  "manifestSha256": {
                    "$ref": "#/$defs/sha256"
                  },
                  "publicRevision": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "forwardTest": {
                "properties": {
                  "state": {
                    "const": "passed"
                  }
                },
                "required": [
                  "state"
                ]
              }
            },
            "required": [
              "forwardTest"
            ]
          },
          "then": {
            "properties": {
              "forwardTest": {
                "properties": {
                  "resultEvidenceSha256": {
                    "$ref": "#/$defs/sha256"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "forwardTest": {
                "properties": {
                  "state": {
                    "enum": [
                      "planned",
                      "failed"
                    ]
                  }
                },
                "required": [
                  "state"
                ]
              }
            },
            "required": [
              "forwardTest"
            ]
          },
          "then": {
            "properties": {
              "forwardTest": {
                "properties": {
                  "resultEvidenceSha256": {
                    "type": "null"
                  }
                }
              }
            }
          }
        }
      ],
      "properties": {
        "gapId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "state": {
          "type": "string",
          "enum": [
            "evidence-needed",
            "lesson-drafted",
            "target-implemented",
            "forward-test-pending",
            "verified",
            "rejected-deck-specific",
            "rejected-subjective-only"
          ]
        },
        "classification": {
          "type": "string",
          "enum": [
            "ai-judgment",
            "product-execution",
            "validator-coverage",
            "subjective-alternative"
          ]
        },
        "originEvidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidenceId",
              "evidenceClass",
              "sha256"
            ],
            "properties": {
              "evidenceId": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:[-:.][a-z0-9]+)*$"
              },
              "evidenceClass": {
                "type": "string",
                "enum": [
                  "accepted-render",
                  "blind-review",
                  "public-contract-test",
                  "public-forward-test",
                  "public-teaching-artifact",
                  "repeated-classified-failure"
                ]
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        "generalizedLesson": {
          "type": "string",
          "minLength": 20
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifactKind",
            "publicArtifactId"
          ],
          "properties": {
            "artifactKind": {
              "type": "string",
              "enum": [
                "skill",
                "skill-reference",
                "capability-atlas",
                "casebook",
                "public-help",
                "public-schema",
                "public-validator",
                "universal-product-invariant"
              ]
            },
            "publicArtifactId": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:[-:.][a-z0-9]+)*$"
            }
          }
        },
        "forwardTest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "testId",
            "state",
            "resultEvidenceSha256"
          ],
          "properties": {
            "testId": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:[-:.][a-z0-9]+)*$"
            },
            "state": {
              "type": "string",
              "enum": [
                "planned",
                "failed",
                "passed"
              ]
            },
            "resultEvidenceSha256": {
              "anyOf": [
                {
                  "$ref": "#/$defs/sha256"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "releaseBinding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "manifestSha256",
            "publicRevision"
          ],
          "oneOf": [
            {
              "properties": {
                "manifestSha256": {
                  "type": "null"
                },
                "publicRevision": {
                  "type": "null"
                }
              }
            },
            {
              "properties": {
                "manifestSha256": {
                  "$ref": "#/$defs/sha256"
                },
                "publicRevision": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                }
              }
            }
          ],
          "properties": {
            "manifestSha256": {
              "anyOf": [
                {
                  "$ref": "#/$defs/sha256"
                },
                {
                  "type": "null"
                }
              ]
            },
            "publicRevision": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "sealedPromptMaterialPresent": {
          "const": false
        },
        "privateDetailsPresent": {
          "const": false
        }
      }
    }
  }
}
