  },
  "contentStory": {
    "audience": "Executive leadership",
    "outcome": "Reach the three operating decisions required this month.",
    "remember": "Performance is on plan, while delivery capacity and enterprise conversion need deliberate action."
  },
  "visualDesign": {
    "world": "Quiet boardroom dashboard",
    "framing": "Restrained executive surfaces, clear hierarchy, and evidence-led composition."
  },
  "motionTime": {
    "masterClock": "native narration when present; otherwise the authored slide timeline",
    "timingSource": "Authoring Excellence Motion/Time plan",
    "syncPolicy": "One governed clock coordinates narration, builds, transitions, presenters, and annotations."
  },
  "styleIntent": {
    "density": "executive-medium",
    "tone": "direct",
    "visualSystem": "quiet boardroom dashboard",
    "avoid": ["decorative hero art", "low-contrast text", "crowded labels"]
  },
  "theme": {
    "name": "Executive Slate",
    "palette": ["0B1220", "2563EB", "14B8A6", "F59E0B", "F8FAFC"],
    "fontFace": "Aptos"
  },
  "sections": [
    {
      "id": "overview",
      "title": "Overview",
