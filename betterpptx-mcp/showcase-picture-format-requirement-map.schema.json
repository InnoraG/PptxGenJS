{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "betterpptx.showcase-picture-format-requirement-map.schema.v1",
  "title": "BetterPPTX showcase Picture Format requirement map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedFrom",
    "scopeFingerprint",
    "counts",
    "classificationPolicy",
    "sourceObservations",
    "sourceRequiredControls",
    "sourceImageUses",
    "programFamilies",
    "nextProofRow",
    "firstContractGap",
    "proofProtocol",
    "proofLedger"
  ],
  "properties": {
    "schemaVersion": { "const": "betterpptx.showcase-picture-format-requirement-map.v1" },
    "generatedFrom": { "type": "object" },
    "scopeFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "counts": { "type": "object" },
    "classificationPolicy": { "type": "object" },
    "sourceObservations": { "type": "object" },
    "sourceRequiredControls": { "type": "array", "minItems": 1 },
    "sourceImageUses": { "type": "array", "minItems": 29, "maxItems": 29 },
    "programFamilies": { "type": "array", "minItems": 14, "maxItems": 14 },
    "nextProofRow": { "type": "object" },
    "firstContractGap": { "type": "object" },
    "proofProtocol": { "type": "object" },
    "proofLedger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "verifiedControlIds"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "verifiedControlIds": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
