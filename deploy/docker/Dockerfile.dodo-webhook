# syntax=docker/dockerfile:1

FROM node:20-bookworm-slim AS deps
WORKDIR /app
RUN printf '%s\n' \
  '{"private":true,"type":"module","dependencies":{"@google-cloud/firestore":"7.11.6","express":"5.2.1"}}' \
  > package.json \
  && npm install --omit=dev --no-audit --no-fund --package-lock=false

FROM node:20-bookworm-slim AS runtime
ENV NODE_ENV=production \
    BETTERPPTX_HOST=0.0.0.0 \
    BETTERPPTX_PORT=8080
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY betterpptx-mcp/server-dodo-webhook.mjs ./betterpptx-mcp/server-dodo-webhook.mjs
COPY betterpptx-mcp/billing ./betterpptx-mcp/billing
RUN useradd -u 10001 -m appuser && chown -R appuser /app
USER appuser
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||process.env.BETTERPPTX_PORT||8080)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "betterpptx-mcp/server-dodo-webhook.mjs"]
