# syntax=docker/dockerfile:1

FROM python:3.11-slim
ENV PIPER_VOICES_DIR=/voices \
    PIPER_PORT=5000 \
    PIPER_SYNTH_TIMEOUT_SECONDS=300
WORKDIR /srv/piper
RUN apt-get update \
 && apt-get install -y --no-install-recommends espeak-ng ca-certificates \
 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir piper-tts
COPY piper_http_shim.py /srv/piper/piper_http_shim.py
RUN useradd -u 10002 -m piper && mkdir -p /voices && chown -R piper /srv/piper /voices
USER piper
EXPOSE 5000
HEALTHCHECK --interval=15s --timeout=4s --start-period=30s --retries=5 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:5000/voices')"
CMD ["python", "/srv/piper/piper_http_shim.py"]
