*

!package.json
!package-lock.json
!rollup.config.mjs
!tsconfig.json
!gulpfile.js
!PPTX_ULTIMATE_DECYPHER_TOOL.mjs
!ULTIMATE_PPTX_XPATH_COMPARATOR_v2h_DECYPHER.ps1

!src/
!src/**
# COMMITTED-DIST contract (owner 2026-07-14): the image mirrors the locally built, committed dist —
# BUILD_DIST=0 requires dist/ in the build context or `test -f dist/pptxgen.es.js` fails the build.
!dist/
!dist/**
!tools/
tools/*
!tools/embed-ui-truth-templates.mjs

!betterpptx-mcp/
!betterpptx-mcp/**
# The MCP runtime imports the canonical presenter clipmap at process startup.
# Keep this tracked worker asset in the Cloud Build context.
!betterpptx-mcp/deploy/
!betterpptx-mcp/deploy/model3d-worker/
!betterpptx-mcp/deploy/model3d-worker/**
betterpptx-mcp/.betterpptx-mcp-runtime/**
betterpptx-mcp/.betterpptx-runtime/**
betterpptx-mcp/.betterpptx-cache/**
betterpptx-mcp/.tools/**
betterpptx-mcp/deploy/production.env
# LIVE SECRETS — the local credential store is gitignored but exists on disk; without this exclude a
# local-context build uploads real tokens into the build context/image (G4). Never remove this line.
betterpptx-mcp/config/credential-store.json*
betterpptx-mcp/outputs/**
betterpptx-mcp/log-viewer/**
betterpptx-mcp/narration/voices/runtime/**
# Generated by google-github-actions/auth; never upload federated credentials to Cloud Build.
gha-creds-*.json
# The broad runtime re-inclusion above must not upload local dependencies,
# tenant preservation blobs, or generated build outputs. Docker installs its
# own dependencies from the lockfile; protected blobs belong in private GCS.
**/node_modules/**
**/.betterpptx-locked-assets/**
**/.betterpptx-runtime/**
**/.betterpptx-mcp-runtime/**
**/.betterpptx-cache/**
src/bld/**
**/.codex/**
**/.codex-tmp/**
**/.claude/**
**/.clinerules/**
**/.cursor/**
**/.rovodev/**
**/.tmp*/**
**/validation-output/**
**/*-public-stage-*/**
**/betterpptx-mcp-jobs/**
**/aimcpx-jobs/**
unattended_state.json
# Runtime configuration and identity keys must be provided by the service,
# never uploaded from a maintainer checkout to Cloud Build.
**/.env
**/.env.*
**/*service-account*.json
**/*service_account*.json

!deploy/
deploy/*
!deploy/cloudbuild.mcp.yaml
!deploy/cloudbuild.dodo-webhook.yaml
!deploy/docker/
deploy/docker/*
!deploy/docker/Dockerfile.mcp
!deploy/docker/Dockerfile.dodo-webhook

# The generic deploy/* rule above also matches nested betterpptx-mcp/deploy
# paths; re-include the runtime's canonical presenter assets after that rule.
!betterpptx-mcp/deploy/
!betterpptx-mcp/deploy/model3d-worker/
!betterpptx-mcp/deploy/model3d-worker/**

**/*.pptx
**/*.pptm
**/*.ppsx
**/*.log
debug_*
tmp_*
